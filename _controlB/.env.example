APP_ENV=development

POSTGRES_DB=controlb
POSTGRES_USER=controlb
POSTGRES_PASSWORD=control_dev
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://controlb:control_dev@localhost:5432/controlb

# Chat: URLs exatas dos conectores aprovadas pelo administrador (JSON).
CHAT_ALLOWED_BASE_URLS=[]
