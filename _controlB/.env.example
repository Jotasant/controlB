APP_ENV=development

POSTGRES_DB=controlb
POSTGRES_USER=controlb
POSTGRES_PASSWORD=control_dev
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://controlb:control_dev@localhost:5432/controlb

# Chat: URLs exatas dos conectores aprovadas pelo administrador (JSON).
CHAT_ALLOWED_BASE_URLS=[]
# URL pública do backend, incluindo /api quando o proxy usa esse prefixo.
# CHAT_PUBLIC_BASE_URL=https://controlb.example/api
# Gere uma chave aleatória forte e mantenha-a estável em um gerenciador de segredos.
# CHAT_CREDENTIALS_KEY=

# Transcrição opcional de áudio: instale .[speech] e informe um modelo CTranslate2 local.
# Nenhum áudio é enviado a um serviço de IA externo; não há download automático de modelos.
# CHAT_STT_MODEL_PATH=C:/modelos/faster-whisper-small
CHAT_AUDIO_WORKER_ENABLED=true
